{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Android Gradle Plugin Lint",
          "version": "8.7.3",
          "rules": [
            {
              "id": "UnusedResources",
              "shortDescription": {
                "text": "Unused resources"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "TypographyEllipsis",
              "shortDescription": {
                "text": "Ellipsis string can be replaced with ellipsis character"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "UnusedResources",
          "level": "warning",
          "message": {
            "text": "The resource R.string.setup_next_step_title appears to be unused"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/src/main/res/values/strings.xml"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 13
                }
              }
            }
          ],
          "baselineState": "unchanged"
        },
        {
          "ruleId": "UnusedResources",
          "level": "warning",
          "message": {
            "text": "The resource R.string.setup_next_step_body appears to be unused"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/src/main/res/values/strings.xml"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 13
                }
              }
            }
          ],
          "baselineState": "unchanged"
        },
        {
          "ruleId": "TypographyEllipsis",
          "level": "warning",
          "message": {
            "text": "Replace three periods with the ellipsis character"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/src/main/res/values/strings.xml"
                },
                "region": {
                  "startLine": 38,
                  "startColumn": 38
                }
              }
            }
          ],
          "baselineState": "unchanged"
        },
        {
          "ruleId": "UnusedResources",
          "level": "warning",
          "message": {
            "text": "The resource R.string.service_notification_active appears to be unused"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/src/main/res/values/strings.xml"
                },
                "region": {
                  "startLine": 71,
                  "startColumn": 13
                }
              }
            }
          ],
          "baselineState": "unchanged"
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [],
          "properties": {
            "releaseTarget": "v0.1.3",
            "scope": "v0.1.3 version metadata, workflow code assertion, and final diff"
          }
        }
      ]
    }
  ]
}
